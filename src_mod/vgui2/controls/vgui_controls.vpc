$Macro SRCDIR		"..\.."
$Macro OUTLIBNAME	"vgui_controls"

$Include "$SRCDIR\vpc_scripts\source_lib_base.vpc"

// Conversion notes:
//   - link-library entries in the vcproj ignored (static lib)
//   - 1 file(s) referenced by the vcproj do not exist on disk (listed as comments below)

$Configuration
{
	$Compiler
	{
		$AdditionalIncludeDirectories	"..\..\public;..\..\public\tier1"
		// original vcproj used /YX (automatic PCH, obsolete); the base scripts use 'Not Using Precompiled Headers'
