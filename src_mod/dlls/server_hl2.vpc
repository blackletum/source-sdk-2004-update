//-----------------------------------------------------------------------------
//	SERVER_HL2.VPC
//
//	Project Script - Source SDK 2004, HL2 branch
//
//	Converted ONCE from dlls/hl_sdk_hl2.vcproj (one-time script conversion).
//	From now on edit THIS file; the .vcproj is only kept for reference.
//-----------------------------------------------------------------------------

$Macro SRCDIR		".."
$Macro GAMENAME		"hl2"
$Macro OUTBINNAME	"server"
$Macro OUTBINDIR		"$SRCDIR\..\game\hl2\bin"

$Include "$SRCDIR\vpc_scripts\source_dll_base.vpc"

$Configuration "Debug"
{
	$General
	{
		$OutputDirectory		".\Debug_$GAMENAME"
		$IntermediateDirectory	".\Debug_$GAMENAME"
	}
}

$Configuration "Release"
{
	$General
	{
		$OutputDirectory		".\Release_$GAMENAME"
		$IntermediateDirectory	".\Release_$GAMENAME"
	}
}

// Conversion notes:
//   - Include dir '..\..\dlls' dropped: it does not exist on disk (resolves outside / to a missing folder; copy/paste leftover in the 2004 vcproj)
//   - 1 file(s) referenced by the vcproj do not exist on disk (listed as comments below)
//   - 84 file(s) were ExcludedFromBuild in the vcproj (HL2-branch leftovers from the SDK
//     multiplayer template, or unused code) and are omitted here; see the list at the end of this file.

$Configuration
{
	$General
	{
		$CharacterSet			"Not Set"
	}

	$Compiler
	{
		$AdditionalIncludeDirectories	"..\game_shared\hl2;.;..\Public;..\Public\tier1;..\game_shared;..\utils\common;..\dlls;..\dlls\hl2_dll"
		$PreprocessorDefinitions		"$BASE;HL2_DLL;USES_SAVERESTORE;GAME_DLL;sprintf=use_Q_snprintf_instead_of_sprintf;VECTOR;strncpy=use_Q_strncpy_instead;_snprintf=use_Q_snprintf_instead;PROTECTED_THINGS_ENABLE"
		$Create/UsePrecompiledHeader	"Use Precompiled Header (/Yu)"
		$Create/UsePCHThroughFile		"cbase.h"
		$PrecompiledHeaderFile		"$(IntDir)/server.pch"
	}

	$Linker
	{
		$IgnoreImportLibrary		"TRUE"
		$AdditionalDependencies	"$BASE winmm.lib"
		$BaseAddress				"0x22000000"
	}
}

$Configuration "Debug"
{
	$Compiler
	{
		$PreprocessorDefinitions	"$BASE;fopen=dont_use_fopen"
	}
}

