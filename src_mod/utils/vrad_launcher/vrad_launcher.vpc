//-----------------------------------------------------------------------------
//	VRAD_LAUNCHER.VPC
//
//	Project Script - Source SDK 2004, HL2 branch
//
//	Converted ONCE from utils/vrad_launcher/vrad_launcher.vcproj (one-time script conversion).
//	From now on edit THIS file; the .vcproj is only kept for reference.
//-----------------------------------------------------------------------------

$Macro SRCDIR		"..\.."
$Macro OUTBINNAME	"vrad"
$Macro OUTBINDIR		"$SRCDIR\..\game\bin"

$Include "$SRCDIR\vpc_scripts\source_exe_con_base.vpc"

$Configuration "Debug"
{
	$General
	{
		$OutputDirectory		".\Debug"
		$IntermediateDirectory	".\Debug"
	}
}

$Configuration "Release"
{
	$General
	{
		$OutputDirectory		".\Release"
		$IntermediateDirectory	".\Release"
	}
}

$Configuration
{
	$Compiler
	{
		$AdditionalIncludeDirectories	"..\..\public;..\..\public\tier1"
		$PreprocessorDefinitions		"$BASE;WIN32;_CONSOLE"
		$Create/UsePrecompiledHeader	"Use Precompiled Header (/Yu)"
		$Create/UsePCHThroughFile		"stdafx.h"
		$PrecompiledHeaderFile		"$(IntDir)/vrad.pch"
	}
}

$Project	"vrad_launcher"
{
	$Folder	"Source Files"
	{
		$File	"..\..\tier1\interface.cpp"
		{
			$Configuration
			{
				$Compiler
				{
					$Create/UsePrecompiledHeader	"Not Using Precompiled Headers"
				}
			}
		}
		$File	"StdAfx.cpp"
		{
			$Configuration
			{
				$Compiler
				{
					$Create/UsePrecompiledHeader	"Create Precompiled Header (/Yc)"
				}
			}
		}
		$File	"vrad_launcher.cpp"
	}

	$Folder	"Header Files"
	{
		$File	"..\..\public\tier1\interface.h"
		$File	"..\..\public\ivraddll.h"
		$File	"StdAfx.h"
	}

	$Folder	"Link Libraries"
	{
		$Implib	"$LIBPUBLIC\tier0"
		$Implib	"$LIBPUBLIC\vstdlib"
	}
}

