//-----------------------------------------------------------------------------
//	VBSP.VPC
//
//	Project Script - Source SDK 2004, HL2 branch
//
//	Converted ONCE from utils/vbsp/vbsp.vcproj (one-time script conversion).
//	From now on edit THIS file; the .vcproj is only kept for reference.
//-----------------------------------------------------------------------------

$Macro SRCDIR		"..\.."
$Macro OUTBINNAME	"vbsp"
$Macro OUTBINDIR		"$SRCDIR\..\game\bin"

$Include "$SRCDIR\vpc_scripts\source_exe_con_base.vpc"

$Configuration "Debug"
{
	$General
	{
		$OutputDirectory		".\Debug"
		$IntermediateDirectory	".\Debug"
	}
}

$Configuration "Release"
{
	$General
	{
		$OutputDirectory		".\Release"
		$IntermediateDirectory	".\Release"
	}
}

// Conversion notes:
//   - 2 file(s) referenced by the vcproj do not exist on disk (listed as comments below)

$Configuration
{
	$Compiler
	{
		$AdditionalIncludeDirectories	"..\..\Public;..\..\Public\tier1;..\common;..\vmpi"
		$PreprocessorDefinitions		"$BASE;MACRO_MATHLIB;_CONSOLE;PROTECTED_THINGS_DISABLE"
		// original vcproj used /YX (automatic PCH, obsolete); the base scripts use 'Not Using Precompiled Headers'
	}

	$Linker
	{
		$AdditionalDependencies	"$BASE ws2_32.lib odbc32.lib odbccp32.lib winmm.lib"
	}
}

$Configuration "Debug"
{
	$Compiler
	{
		$PreprocessorDefinitions	"$BASE;DEBUG"
	}
}

$Project	"vbsp"
{
