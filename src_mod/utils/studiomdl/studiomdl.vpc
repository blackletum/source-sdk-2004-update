//-----------------------------------------------------------------------------
//	STUDIOMDL.VPC
//
//	Project Script - Source SDK 2004, HL2 branch
//
//	Converted ONCE from utils/studiomdl/studiomdl.vcproj (one-time script conversion).
//	From now on edit THIS file; the .vcproj is only kept for reference.
//-----------------------------------------------------------------------------

$Macro SRCDIR		"..\.."
$Macro OUTBINNAME	"studiomdl"
$Macro OUTBINDIR		"$SRCDIR\..\game\bin"

$Include "$SRCDIR\vpc_scripts\source_exe_con_base.vpc"

$Configuration "Debug"
{
	$General
	{
		$OutputDirectory		".\Debug"
		$IntermediateDirectory	".\Debug"
	}
}

$Configuration "Release"
{
	$General
	{
		$OutputDirectory		".\Release"
		$IntermediateDirectory	".\Release"
	}
}

$Configuration
{
	$General
	{
		$CharacterSet			"Not Set"
	}

	$Compiler
	{
		$AdditionalIncludeDirectories	"..\common;..\..\public;..\..\public\tier1;..\nvtristriplib;..\..\Game_Shared"
		$PreprocessorDefinitions		"$BASE;_CONSOLE;PROTECTED_THINGS_DISABLE"
	}

	$Linker
	{
		$AdditionalDependencies	"$BASE winmm.lib"
	}
}

$Project	"studiomdl"
{
