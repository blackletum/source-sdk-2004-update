//-----------------------------------------------------------------------------
//	SERVERPLUGIN_EMPTY.VPC
//
//	Project Script - Source SDK 2004, HL2 branch
//
//	Converted ONCE from utils/serverplugin_sample/serverplugin_empty.vcproj (one-time script conversion).
//	From now on edit THIS file; the .vcproj is only kept for reference.
//-----------------------------------------------------------------------------

$Macro SRCDIR		"..\.."
$Macro OUTBINNAME	"serverplugin_empty"
$Macro OUTBINDIR		"$SRCDIR\..\game\bin"

$Include "$SRCDIR\vpc_scripts\source_dll_base.vpc"

$Configuration "Debug"
{
	$General
	{
		$OutputDirectory		".\Debug"
		$IntermediateDirectory	".\Debug"
	}
}

$Configuration "Release"
{
	$General
	{
		$OutputDirectory		".\Release"
		$IntermediateDirectory	".\Release"
	}
}

$Configuration
{
	$Compiler
	{
		$AdditionalIncludeDirectories	"..\..\public;..\..\public\tier0;..\..\public\tier1;..\..\dlls;..\..\game_shared"
		$PreprocessorDefinitions		"$BASE;WIN32;serverplugin_emptyONLY"
		$EnableC++Exceptions		"Yes (/EHsc)"
		// original vcproj used /YX (automatic PCH, obsolete); the base scripts use 'Not Using Precompiled Headers'
	}

	$Linker
	{
		$AdditionalDependencies	"$BASE odbc32.lib odbccp32.lib"
	}
}

$Project	"serverplugin_empty"
{
	$Folder	"Source Files"
	{
		$File	"..\..\tier1\convar.cpp"
		$File	"..\..\tier1\interface.cpp"
		$File	"..\..\tier1\KeyValues.cpp"
		$File	"..\..\public\tier0\memoverride.cpp"
		$File	"serverplugin_convar.cpp"
		$File	"serverplugin_empty.cpp"
		$File	"..\..\tier1\utlbuffer.cpp"
	}

	$Folder	"Header Files"
	{
		$File	"..\..\Public\basetypes.h"
		$File	"..\..\public\Color.h"
		$File	"..\..\public\tier0\dbg.h"
		$File	"..\..\Public\eiface.h"
		$File	"..\..\Public\FileSystem.h"
		$File	"..\..\public\vstdlib\ICommandLine.h"
		$File	"..\..\public\igameevents.h"
		$File	"..\..\public\tier1\interface.h"
		$File	"..\..\public\dlls\iplayerinfo.h"
		$File	"..\..\public\engine\iserverplugin.h"
		$File	"..\..\public\tier1\KeyValues.h"
		$File	"..\..\public\tier0\mem.h"
		$File	"..\..\public\tier0\memalloc.h"
		$File	"..\..\public\tier0\memdbgon.h"
		$File	"..\..\public\vstdlib\strtools.h"
		$File	"..\..\public\tier1\utlbuffer.h"
		$File	"..\..\public\tier1\utlmemory.h"
		$File	"..\..\public\tier1\utlvector.h"
		$File	"..\..\public\vstdlib\vstdlib.h"
	}

	$Folder	"Link Libraries"
	{
		$Implib	"$LIBPUBLIC\tier0"
		$Implib	"$LIBPUBLIC\vstdlib"
	}
}

