//-----------------------------------------------------------------------------
//	VRAD.VPC
//
//	Project Script - Source SDK 2004, HL2 branch
//
//	Converted ONCE from utils/vrad/vrad.vcproj (one-time script conversion).
//	From now on edit THIS file; the .vcproj is only kept for reference.
//-----------------------------------------------------------------------------

$Macro SRCDIR		"..\.."
$Macro OUTBINNAME	"vrad"
$Macro OUTBINDIR		"$SRCDIR\..\game\bin"

$Include "$SRCDIR\vpc_scripts\source_dll_base.vpc"

$Configuration "Debug"
{
	$General
	{
		$OutputDirectory		".\Debug"
		$IntermediateDirectory	".\Debug"
	}
}

$Configuration "Release"
{
	$General
	{
		$OutputDirectory		".\Release"
		$IntermediateDirectory	".\Release"
	}
}

// Conversion notes:
//   - Include dir '..\vmpi\mysql\mysqlpp\include' dropped: it does not exist on disk (resolves outside / to a missing folder; copy/paste leftover in the 2004 vcproj)
//   - Include dir '..\vmpi\mysql\include' dropped: it does not exist on disk (resolves outside / to a missing folder; copy/paste leftover in the 2004 vcproj)
//   - the vcproj requested assembly listings (/FA); not carried over
//   - 1 file(s) referenced by the vcproj do not exist on disk (listed as comments below)

$Configuration
{
	$Compiler
	{
		$AdditionalIncludeDirectories	"..\common;..\..\public;..\..\public\tier1;..\vmpi"
		$PreprocessorDefinitions		"$BASE;WIN32;MPI;PROTECTED_THINGS_DISABLE"
		// original vcproj used /YX (automatic PCH, obsolete); the base scripts use 'Not Using Precompiled Headers'
	}

	$Linker
	{
		$AdditionalDependencies	"$BASE ws2_32.lib"
	}
}

