//-----------------------------------------------------------------------------
//	HEIGHT2NORMAL.VPC
//
//	Project Script - Source SDK 2004, HL2 branch
//
//	Converted ONCE from utils/height2normal/height2normal.vcproj (one-time script conversion).
//	From now on edit THIS file; the .vcproj is only kept for reference.
//-----------------------------------------------------------------------------

$Macro SRCDIR		"..\.."
$Macro OUTBINNAME	"height2normal"
$Macro OUTBINDIR		"$SRCDIR\..\game\bin"

$Include "$SRCDIR\vpc_scripts\source_exe_con_base.vpc"

$Configuration "Debug"
{
	$General
	{
		$OutputDirectory		".\Debug"
		$IntermediateDirectory	".\Debug"
	}
}

$Configuration "Release"
{
	$General
	{
		$OutputDirectory		".\Release"
		$IntermediateDirectory	".\Release"
	}
}

$Configuration
{
	$Compiler
	{
		$AdditionalIncludeDirectories	"..\..\public;..\..\public\tier1;..\common"
		$PreprocessorDefinitions		"$BASE;TGAWRITER_USE_FOPEN;IMAGE_LOADER_NO_DXTC;TGALOADER_USE_FOPEN;WIN32;_CONSOLE"
		// original vcproj used /YX (automatic PCH, obsolete); the base scripts use 'Not Using Precompiled Headers'
	}
}

$Project	"height2normal"
{
	$Folder	"Source Files"
	{
		$File	"..\..\tier1\characterset.cpp"
		$File	"..\common\cmdlib.cpp"
		$File	"..\..\public\filesystem_helpers.cpp"
		$File	"..\..\public\filesystem_helpers.h"
		$File	"..\..\public\filesystem_init.cpp"
		$File	"..\common\filesystem_tools.cpp"
		$File	"..\common\filesystem_tools.h"
		$File	"height2normal.cpp"
		$File	"..\..\Public\ImageLoader.cpp"
		$File	"..\..\tier1\interface.cpp"
		$File	"..\..\tier1\KeyValues.cpp"
		$File	"..\..\public\tier1\KeyValues.h"
		$File	"..\..\Public\Mathlib.cpp"
		$File	"..\..\Public\TGALoader.cpp"
		$File	"..\..\Public\TGAWriter.cpp"
		$File	"..\..\tier1\utlbuffer.cpp"
	}

	$Folder	"Header Files"
	{
		$File	"..\..\public\tier1\characterset.h"
		$File	"..\..\Public\ImageLoader.h"
		$File	"..\..\public\tier1\interface.h"
		$File	"..\..\Public\TGALoader.h"
		$File	"..\..\Public\TGAWriter.h"
		$File	"..\..\public\tier1\utlbuffer.h"
	}

	$Folder	"Link Libraries"
	{
		$Implib	"$LIBPUBLIC\tier0"
		$Implib	"$LIBPUBLIC\vstdlib"
	}
}

