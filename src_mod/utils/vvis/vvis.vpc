		$File	"..\common\cmdlib.cpp"
		$File	"..\..\public\collisionutils.cpp"
		$File	"..\..\public\filesystem_helpers.cpp"
		$File	"flow.cpp"
		$File	"..\..\tier1\interface.cpp"
		$File	"..\..\tier1\KeyValues.cpp"
		$File	"..\..\Public\Mathlib.cpp"
		$File	"..\common\mpi_stats.cpp"
		$File	"mpivis.cpp"
		$File	"..\common\MySqlDatabase.cpp"
		$File	"..\common\pacifier.cpp"
		$File	"..\common\scriplib.cpp"
		$File	"..\common\threads.cpp"
		$File	"..\..\tier1\utlbuffer.cpp"
		$File	"..\..\tier1\utlsymbol.cpp"
		$File	"..\common\vmpi_tools_shared.cpp"
