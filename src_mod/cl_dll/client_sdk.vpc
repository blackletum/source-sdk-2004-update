//-----------------------------------------------------------------------------
//	CLIENT_SDK.VPC
//
//	Project Script - Source SDK 2004, HL2 branch
//
//	Converted ONCE from cl_dll/client_sdk.vcproj (one-time script conversion).
//	From now on edit THIS file; the .vcproj is only kept for reference.
//-----------------------------------------------------------------------------

$Macro SRCDIR		".."
$Macro GAMENAME		"sdk"
$Macro OUTBINNAME	"client"
$Macro OUTBINDIR		"$SRCDIR\..\game\sdk\bin"

$Include "$SRCDIR\vpc_scripts\source_dll_base.vpc"

$Configuration "Debug"
{
	$General
	{
		$OutputDirectory		".\Debug_$GAMENAME"
		$IntermediateDirectory	".\Debug_$GAMENAME"
	}
}

$Configuration "Release"
{
	$General
	{
		$OutputDirectory		".\Release_$GAMENAME"
		$IntermediateDirectory	".\Release_$GAMENAME"
	}
}

// Conversion notes:
//   - Include dir '..\vgui2\include' dropped: it does not exist on disk (resolves outside / to a missing folder; copy/paste leftover in the 2004 vcproj)
//   - 'ragdoll.h' was listed twice in the vcproj; only the first entry is kept
//   - '..\game_shared\shareddefs.h' was listed twice in the vcproj; only the first entry is kept
//   - '..\game_shared\sharedInterface.h' was listed twice in the vcproj; only the first entry is kept
//   - 9 file(s) referenced by the vcproj do not exist on disk (listed as comments below)
//   - 75 file(s) were ExcludedFromBuild in the vcproj (HL2-branch leftovers from the SDK
//     multiplayer template, or unused code) and are omitted here; see the list at the end of this file.

$Configuration
{
	$Compiler
	{
		$PreprocessorDefinitions		"$BASE;SDK_DLL;NO_STRING_T;CLIENT_DLL;VECTOR;strncpy=use_Q_strncpy_instead;_snprintf=use_Q_snprintf_instead;PROTECTED_THINGS_ENABLE"
		$Create/UsePrecompiledHeader	"Use Precompiled Header (/Yu)"
		$Create/UsePCHThroughFile		"cbase.h"
		$PrecompiledHeaderFile		"$(IntDir)/client.pch"
	}

	$Linker
	{
		$IgnoreImportLibrary		"TRUE"
		$AdditionalDependencies	"$BASE winmm.lib"
		$BaseAddress				"0x24000000"
	}
}

$Configuration "Debug"
{
	$Compiler
	{
		$AdditionalIncludeDirectories	"..\Public\tier1;sdk;sdk\vgui;..\game_shared\sdk;.;..\Public;..\vgui2\controls;..\game_shared;game_controls"
		$PreprocessorDefinitions	"$BASE;fopen=dont_use_fopen"
	}
}

$Configuration "Release"
{
	$Compiler
	{
		$AdditionalIncludeDirectories	"..\Public\tier1;sdk\vgui;sdk;..\game_shared\sdk;.;..\Public;..\vgui2\controls;..\game_shared;game_controls"
	}
}

